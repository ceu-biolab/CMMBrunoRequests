meta {
  name: LC-IM-MS Search - With Scores
  type: http
  seq: 25
}

post {
  url: {{base_url}}/api/lcimms-search
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "mzValues": [
    790.63203,
    782.56943
  ],
  "ccsValues": [
    291.175,
    294.385
  ],
  "rtValues": [
    6.0,
    5.0
  ],
  "mzToleranceMode": "PPM",
  "mzTolerance": 5,
  "ccsToleranceMode": "PERCENTAGE",
  "ccsTolerance": 1.5,
  "ionizationMode": "POSITIVE",
  "bufferGas": "N2",
  "adducts": [
    "[M+H]+"
  ],
  "formulaType": "CHNOPS",
  "experimentParameters": {
    "ionMode": "POSITIVE",
    "modifierType": "NONE"
  }
  }
}


settings {
  timeout: 60000
}

vars:pre-request {
  cmm_response_contract: im
}

assert {
  res.status: eq 200
  res.body.imFeatures.length: eq 2
}

tests {
  test('Feature values preserve request order', () => {
    const rows = res.getBody().imFeatures;
    const expectedValues = [790.63203,782.56943];
    expect(rows).to.have.lengthOf(expectedValues.length);
    rows.forEach((row, i) => expect(row.feature.mzValue).to.be.closeTo(expectedValues[i], 0.0000001));
  });
}
