meta {
  name: IM-MS Search
  type: http
  seq: 24
}

post {
  url: {{base_url}}/api/imms-search
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mzValues": [
      400.3432,
      281.24765
    ],
    "ccsValues": [
      202.881,
      178.546
    ],
    "mzToleranceMode": "PPM",
    "mzTolerance": 10,
    "ccsToleranceMode": "PERCENTAGE",
    "ccsTolerance": 2,
    "ionizationMode": "POSITIVE",
    "bufferGas": "N2",
    "adducts": [
      "[M+H]+"
    ],
    "formulaType": "CHNOPS"
  }
}


settings {
  timeout: 60000
}

vars:pre-request {
  cmm_response_contract: im
}

assert {
  res.status: eq 200
  res.body.imFeatures.length: eq 2
}

tests {
  test('Feature values preserve request order', () => {
    const rows = res.getBody().imFeatures;
    const expectedValues = [400.3432,281.24765];
    expect(rows).to.have.lengthOf(expectedValues.length);
    rows.forEach((row, i) => expect(row.feature.mzValue).to.be.closeTo(expectedValues[i], 0.0000001));
  });
}
