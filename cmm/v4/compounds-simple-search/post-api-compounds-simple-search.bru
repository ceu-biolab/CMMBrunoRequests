meta {
  name: Compounds Simple Search
  type: http
  seq: 32
}

post {
  url: {{base_url}}/api/compounds/simple-search
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mz": 757.5667,
    "mzToleranceMode": "PPM",
    "tolerance": 10,
    "ionizationMode": "POSITIVE",
    "adductsString": [
      "[M+H]+",
      "[M+Na]+",
      "[M+K]+",
      "[M+NH4]+",
      "[M+H-H2O]+"
    ],
    "databases": [
      "HMDB",
      "LIPIDMAPS",
      "ASPERGILLUS",
      "FAHFA",
      "KEGG",
      "INHOUSE",
      "CHEBI",
      "PUBCHEM",
      "NPATLAS"
    ],
    "metaboliteType": "ALL"
  }
}


settings {
  timeout: 60000
}

vars:pre-request {
  cmm_response_contract: ms
}

assert {
  res.status: eq 200
  res.body.msfeatures.length: eq 1
}

tests {
  test('Feature values preserve request order', () => {
    const rows = res.getBody().msfeatures;
    const expectedValues = [757.5667];
    expect(rows).to.have.lengthOf(expectedValues.length);
    rows.forEach((row, i) => expect(row.feature.mzValue).to.be.closeTo(expectedValues[i], 0.0000001));
  });
}
