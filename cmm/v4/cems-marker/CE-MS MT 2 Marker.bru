meta {
  name: CE-MS MT 2 Marker
  type: http
  seq: 29
}

post {
  url: {{base_url}}/api/cems-2-marker
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "masses": [
      291.1299,
      298.098,
      308.094,
      316.2488,
      55.055
    ],
    "tolerance": 10,
    "tolerance_mode": "ppm",
    "mt": [
      11.56,
      13.65,
      15.62,
      12.59,
      6.99
    ],
    "mt_tolerance": 10,
    "mt_tolerance_mode": "percentage",
    "buffer": "FORMIC_ACID_1M",
    "temperature": 20,
    "polarity": "Direct",
    "marker1": "L-Methionine sulfone",
    "marker1_time": 14.24,
    "marker2": "Hippuric acid",
    "marker2_time": 25.29,
    "chemical_alphabet": "CHNOPS",
    "ion_mode": "positive",
    "adducts": [
      "[M+H]+",
      "[M+2H]2+",
      "[M+Na]+",
      "[M+K]+",
      "[M+NH4]+",
      "[M+H-H2O]+"
    ]
  }
}


settings {
  timeout: 60000
}

vars:pre-request {
  cmm_response_contract: ce
}

assert {
  res.status: eq 200
  res.body.ceFeatures.length: eq 5
}

tests {
  test('Feature values preserve request order', () => {
    const rows = res.getBody().ceFeatures;
    const expectedValues = [291.1299,298.098,308.094,316.2488,55.055];
    expect(rows).to.have.lengthOf(expectedValues.length);
    rows.forEach((row, i) => expect(row.feature.mzValue).to.be.closeTo(expectedValues[i], 0.0000001));
  });
}
