meta {
  name: Legacy v3 batch
  type: http
  seq: 166
}

post {
  url: {{base_url}}/api/v3/batch
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tolerance": 10,
    "tolerance_mode": "ppm",
    "ion_mode": "positive",
    "masses_mode": "mz",
    "adducts": [
      "M+H"
    ],
    "databases": [
      "all-except-mine"
    ],
    "metabolites_type": "all-except-peptides",
    "masses": [
      181.070664,
      132.101905
    ]
  }

}


settings {
  timeout: 60000
}

vars:pre-request {
  cmm_response_contract: legacyMs
}

assert {
  res.status: eq 200
  res.body.results: isNotEmpty
}
