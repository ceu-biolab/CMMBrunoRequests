meta {
  name: Legacy CE-MS mt1marker
  type: http
  seq: 171
}

post {
  url: {{base_url}}/api/v3/cesearch/mt1marker
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tolerance": 10,
    "tolerance_mode": "ppm",
    "ion_mode": "positive",
    "masses_mode": "mz",
    "adducts": [
      "M+H"
    ],
    "databases": [
      "all-except-mine"
    ],
    "metabolites_type": "all-except-peptides",
    "masses": [
      291.1299,
      298.098,
      308.094,
      316.2488,
      55.055
    ],
    "buffer": "formic-acid-1m-20c",
    "polarity": "direct",
    "chemical_alphabet": "CHNOPS",
    "mt": [
      11.56,
      13.65,
      15.62,
      12.59,
      6.99
    ],
    "mt_tolerance": 10,
    "mt_tolerance_mode": "percentage",
    "marker": "L-Methionine sulfone",
    "marker_time": 14.24,
    "capillary_length": 1000,
    "capillary_voltage": 30
  }

}


settings {
  timeout: 60000
}

vars:pre-request {
  cmm_response_contract: legacyCeMt
}

assert {
  res.status: eq 200
  res.body.compounds_found.length: eq 5
}

tests {
  test('Legacy rows preserve submitted mass order', () => {
    const rows = res.getBody().compounds_found;
    expect(rows.map(row => row.input_mz)).to.deep.equal([291.1299,298.098,308.094,316.2488,55.055]);
  });
}
