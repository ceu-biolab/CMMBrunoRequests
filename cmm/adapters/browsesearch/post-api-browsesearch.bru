meta {
  name: browseSearch 
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/browsesearch
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "choline",
    "exactName": false,
    "formula": "C5H14NO",
    "exactFormula": false,
    "databases": [
      "all-except-mine"
    ],
    "metabolites_type": "all-except-peptides"
  }
}


settings {
  timeout: 60000
}

vars:pre-request {
  cmm_response_contract: legacyBrowse
}

assert {
  res.status: eq 200
}
